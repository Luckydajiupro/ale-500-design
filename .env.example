POSTGRES_DB=ale500
POSTGRES_USER=ale
POSTGRES_PASSWORD=change-me-local-only
ALE_SEED_PASSWORD=AleDemo123!
# Model gateway. The key is never in this file or the image. Put it in
# .secrets/model_api_key with mode 0600, or point ALE_MODEL_SECRET_FILE_HOST
# at a protected file. Keep provider=mock until a real key is configured.
ALE_MODEL_PROVIDER=mock
ALE_MODEL_BASE_URL=
ALE_MODEL_ID=mock-deterministic
ALE_MODEL_STRUCTURED_OUTPUT=none
ALE_MODEL_PROMPT_VERSION=agent-v1
ALE_MODEL_SECRET_FILE_HOST=./.secrets/model_api_key
