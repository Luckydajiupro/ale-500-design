inputs/frozen/
work/
.DS_Store
__pycache__/
*.pyc
.venv/

# 阶段目录整目录随仓库分发。阶段 0 的校验和、阶段 1 的校验器都要在读仓库里能跑，
# 否则"已关闭"和"等复审"这两句话无法被外部复核。
tools/freeze/

# 校验器每次运行都追加这一份日志。它是运行的副产物，不是证据基线。
stages/s1-research/.audit/s1-02c-validator.log

platform/var/

# Model credentials and local backups are never tracked.
.secrets/*
!.secrets/README.md
docs/evidence/*/backup/db.dump
